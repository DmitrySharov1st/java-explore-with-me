{
  "info": {
    "_postman_id": "feature-comments-001",
    "name": "Feature: Comments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public: get comments for event",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const main = async () => {",
              "    const api = new API(pm);",
              "    const rnd = new RandomUtils();",
              "    try {",
              "        const user = await api.addUser(rnd.getUser());",
              "        const category = await api.addCategory(rnd.getCategory());",
              "        let event = rnd.getEvent(category.id);",
              "        event = await api.addEvent(user.id, event);",
              "        event = await api.publishEvent(event.id);",
              "        pm.collectionVariables.set('eventId', event.id);",
              "        // создадим два комментария",
              "        const comment1 = await api.addComment(user.id, event.id, rnd.getComment());",
              "        const comment2 = await api.addComment(user.id, event.id, rnd.getComment());",
              "        pm.collectionVariables.set('commentId', comment1.id);",
              "        pm.collectionVariables.set('userId', user.id);",
              "    } catch(err) {",
              "        console.error('Ошибка при подготовке тестовых данных.', err);",
              "    }",
              "};",
              "const interval = setInterval(() => {}, 1000);",
              "setTimeout(async () => {",
              "    try { await main(); } catch (e) { console.error(e); } finally { clearInterval(interval); }",
              "}, 100);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Ответ должен содержать код статуса 200 и данные в формате json', function () {",
              "    pm.response.to.be.ok;",
              "    pm.response.to.be.withBody;",
              "    pm.response.to.be.json;",
              "});",
              "const target = pm.response.json();",
              "pm.test('Должно вернуться как минимум 2 комментария', function () {",
              "    pm.expect(target.length).to.be.gte(2);",
              "});",
              "pm.test('Комментарии должны содержать поля: id, text, authorId, eventId, created, edited, status', function () {",
              "    target.forEach(c => {",
              "        pm.expect(c).to.have.property('id');",
              "        pm.expect(c).to.have.property('text');",
              "        pm.expect(c).to.have.property('authorId');",
              "        pm.expect(c).to.have.property('eventId');",
              "        pm.expect(c).to.have.property('created');",
              "        pm.expect(c).to.have.property('edited');",
              "        pm.expect(c).to.have.property('status');",
              "    });",
              "});",
              "pm.test('Статус всех комментариев должен быть APPROVED', function () {",
              "    target.forEach(c => pm.expect(c.status).to.eql('APPROVED'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}/comments?from=0&size=10",
          "host": ["{{baseUrl}}"],
          "path": ["events", "{{eventId}}", "comments"],
          "query": [
            {"key": "from", "value": "0"},
            {"key": "size", "value": "10"}
          ]
        }
      },
      "response": []
    },
    {
      "name": "Private: add comment",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const main = async () => {",
              "    const api = new API(pm);",
              "    const rnd = new RandomUtils();",
              "    try {",
              "        const user = await api.addUser(rnd.getUser());",
              "        const category = await api.addCategory(rnd.getCategory());",
              "        let event = rnd.getEvent(category.id);",
              "        event = await api.addEvent(user.id, event);",
              "        event = await api.publishEvent(event.id);",
              "        pm.collectionVariables.set('eventId', event.id);",
              "        pm.collectionVariables.set('userId', user.id);",
              "        const newComment = rnd.getComment();",
              "        pm.request.body.update({",
              "            mode: 'raw',",
              "            raw: JSON.stringify(newComment),",
              "            options: { raw: { language: 'json' } }",
              "        });",
              "    } catch(err) {",
              "        console.error('Ошибка при подготовке тестовых данных.', err);",
              "    }",
              "};",
              "const interval = setInterval(() => {}, 1000);",
              "setTimeout(async () => {",
              "    try { await main(); } catch (e) { console.error(e); } finally { clearInterval(interval); }",
              "}, 100);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Ответ должен содержать код статуса 201 и данные в формате json', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.response.to.be.withBody;",
              "    pm.response.to.be.json;",
              "});",
              "const target = pm.response.json();",
              "pm.test('Комментарий должен содержать поля: id, text, authorId, eventId, created, edited, status', function () {",
              "    pm.expect(target).to.have.property('id');",
              "    pm.expect(target).to.have.property('text');",
              "    pm.expect(target).to.have.property('authorId');",
              "    pm.expect(target).to.have.property('eventId');",
              "    pm.expect(target).to.have.property('created');",
              "    pm.expect(target).to.have.property('edited');",
              "    pm.expect(target).to.have.property('status');",
              "});",
              "pm.test('Статус должен быть APPROVED, edited = false', function () {",
              "    pm.expect(target.status).to.eql('APPROVED');",
              "    pm.expect(target.edited).to.be.false;",
              "});",
              "pm.test('Идентификатор события должен соответствовать запросу', function () {",
              "    pm.expect(target.eventId.toString()).to.eql(pm.collectionVariables.get('eventId').toString());",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
